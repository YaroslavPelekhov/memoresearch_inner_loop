export CODEX_MODEL=gpt-5.6-sol
export CODEX_SERVICE_TIER=priority
export CODEX_CONTEXT_TIER=short

export AUTORESEARCH_REDIS_HOST=127.0.0.1
export AUTORESEARCH_REDIS_PORT=16379
export AUTORESEARCH_REDIS_DIR=/home/bulatov/yaroslav-multifidelity/redis
