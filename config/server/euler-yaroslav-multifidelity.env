export AUTORESEARCH_MULTIFIDELITY_PLAN=/home/bulatov/yaroslav-multifidelity/repo/config/multifidelity/dclm-140m.yaml
export AUTORESEARCH_GPUS_PER_CANDIDATE=1
export AUTORESEARCH_TRAIN_MICROBATCH_SIZE=16
export AUTORESEARCH_EVAL_BATCH_SIZE=32
export AUTORESEARCH_LOADER_WORKERS=8
export AUTORESEARCH_GRADIENT_LOG_INTERVAL=20
export AUTORESEARCH_EXPERIMENT_TIMEOUT_SECONDS=43200
export AUTORESEARCH_BENCHMARK_TIMEOUT=43200
export AUTORESEARCH_STAGE_TIMEOUT=43800
export AUTORESEARCH_DAG_TIMEOUT=44400

export CODEX_HOME=/home/bulatov/yaroslav-multifidelity/codex-home
