# Isolated Euler runtime for the Yaroslav multi-fidelity pilot.

export AUTORESEARCH_WORKSPACE_ROOT=/home/bulatov/yaroslav-multifidelity
export AUTORESEARCH_REPO=/home/bulatov/yaroslav-multifidelity/repo
export AUTORESEARCH_PYTHON=/home/bulatov/yaroslav-multifidelity/env/bin/python
export AUTORESEARCH_DATA_ROOT=/home/bulatov/yaroslav-multifidelity/data

# Keep caches, transient files, and tool state out of the shared Unix home.
export XDG_CACHE_HOME=/home/bulatov/yaroslav-multifidelity/.cache
export XDG_CONFIG_HOME=/home/bulatov/yaroslav-multifidelity/.config
export XDG_DATA_HOME=/home/bulatov/yaroslav-multifidelity/.local/share
export HF_HOME=/home/bulatov/yaroslav-multifidelity/.cache/huggingface
export TORCH_HOME=/home/bulatov/yaroslav-multifidelity/.cache/torch
export TRITON_CACHE_DIR=/home/bulatov/yaroslav-multifidelity/.cache/triton
export CUDA_CACHE_PATH=/home/bulatov/yaroslav-multifidelity/.cache/cuda
export PIP_CACHE_DIR=/home/bulatov/yaroslav-multifidelity/.cache/pip
export MPLCONFIGDIR=/home/bulatov/yaroslav-multifidelity/.config/matplotlib
export TMPDIR=/home/bulatov/yaroslav-multifidelity/tmp

export DCLM_MODEL_PATH=/home/bulatov/yaroslav-multifidelity/data/model-template-gpt-neox-140m
export DCLM_MDS_PATH=/home/bulatov/yaroslav-multifidelity/data/dclm-mds-3b-v1
