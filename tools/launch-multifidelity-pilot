#!/usr/bin/env bash
# Validate or explicitly start one isolated multi-fidelity pilot lane.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workspace_root="${AUTORESEARCH_WORKSPACE_ROOT:-$(dirname "$repo_root")}"
runtime_env="${AUTORESEARCH_RUNTIME_ENV:-$repo_root/config/server/euler-yaroslav-multifidelity.env}"
gpu_index=""
campaign_name=""
target_rounds="${AUTORESEARCH_PILOT_TARGET_ROUNDS:-4}"
evolution_generations="${AUTORESEARCH_PILOT_EVOLUTION_GENERATIONS:-4}"
start=false

usage() {
    cat <<'EOF'
Usage: tools/launch-multifidelity-pilot --gpu 0|1 [options]

Options:
  --campaign NAME          Default: multifidelity-pilot-gpu<GPU>
  --target-rounds N        Default: 4
  --evolution-generations N  Default: 4
  --runtime-env PATH       Runtime environment file
  --start                  Start the tmux lane; without this flag only validate
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --gpu)
            gpu_index="$2"
            shift 2
            ;;
        --campaign)
            campaign_name="$2"
            shift 2
            ;;
        --target-rounds)
            target_rounds="$2"
            shift 2
            ;;
        --evolution-generations)
            evolution_generations="$2"
            shift 2
            ;;
        --runtime-env)
            runtime_env="$2"
            shift 2
            ;;
        --start)
            start=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [[ "$gpu_index" != "0" && "$gpu_index" != "1" ]]; then
    echo "--gpu must be 0 or 1" >&2
    exit 2
fi
if ! [[ "$target_rounds" =~ ^[1-9][0-9]*$ ]]; then
    echo "--target-rounds must be positive" >&2
    exit 2
fi
if ! [[ "$evolution_generations" =~ ^[1-9][0-9]*$ ]]; then
    echo "--evolution-generations must be positive" >&2
    exit 2
fi
if [[ ! -f "$runtime_env" ]]; then
    echo "Missing runtime environment: $runtime_env" >&2
    exit 3
fi

# shellcheck disable=SC1090
source "$runtime_env"
workspace_root="${AUTORESEARCH_WORKSPACE_ROOT:-$workspace_root}"
campaign_name="${campaign_name:-multifidelity-pilot-gpu${gpu_index}}"
campaign_root="$workspace_root/runs/$campaign_name"
log_path="$workspace_root/logs/${campaign_name}.log"
session_name="yaroslav-mf-gpu${gpu_index}"
tmux_socket="${AUTORESEARCH_TMUX_SOCKET:-$workspace_root/runtime/tmux.sock}"
streaming_prefix_base=$((700000 + gpu_index * 100000))
lane_data_root="${AUTORESEARCH_LANE_DATA_ROOT:-$workspace_root/data-lanes}/gpu${gpu_index}"
lane_mds_path="$lane_data_root/$(basename "$DCLM_MDS_PATH")"
lane_screen_mds_path="$lane_data_root/$(basename "$DCLM_SCREEN_MDS_PATH")"
lane_eval_cache_path="$lane_data_root/eval-cache"

required_paths=(
    "$AUTORESEARCH_PYTHON"
    "$LLMFOUNDRY_TORCHRUN"
    "$AUTORESEARCH_CODEX_BIN"
    "$CODEX_HOME/auth.json"
    "$AUTORESEARCH_PROXY_HOME/xray"
    "$AUTORESEARCH_PROXY_HOME/vless-mlpc.json"
    "$AUTORESEARCH_PROXY_HOME/gost-linux-amd64-2.11.5"
    "$DCLM_MODEL_PATH/tokenizer.json"
    "$DCLM_MDS_PATH/corpus-manifest.json"
    "$DCLM_SCREEN_MDS_PATH/holdout-split-manifest.json"
    "$DCLM_SCREEN_MDS_PATH/validation/index.json"
    "$DCLM_CORE_PATH"
    "$AUTORESEARCH_MULTIFIDELITY_PLAN"
    "$lane_mds_path/corpus-manifest.json"
    "$lane_screen_mds_path/corpus-manifest.json"
    "$lane_screen_mds_path/holdout-split-manifest.json"
    "$lane_screen_mds_path/validation/index.json"
)
for path in "${required_paths[@]}"; do
    if [[ ! -e "$path" ]]; then
        echo "Missing required runtime path: $path" >&2
        exit 3
    fi
done

assert_port_private() {
    local label="$1" host="$2" port="$3" pidfile="$4" owner_root="$5"
    local listener
    listener="$(ss -H -ltnp 2>/dev/null | awk -v endpoint="${host}:${port}" -v port="$port" \
        '$4 == endpoint || $4 ~ (":" port "$") { print; exit }')"
    [[ -z "$listener" ]] && return 0
    if [[ ! -f "$pidfile" ]]; then
        echo "$label port is occupied without our PID file: ${host}:${port}" >&2
        exit 8
    fi
    local pid
    pid="$(tr -cd '0-9' <"$pidfile")"
    local owned_process=false
    if [[ -n "$pid" && -r "/proc/${pid}/cmdline" ]]; then
        if tr '\0' ' ' <"/proc/${pid}/cmdline" | grep -Fq -- "$owner_root"; then
            owned_process=true
        elif [[ "$(readlink -f "/proc/${pid}/cwd")" == "$(realpath "$owner_root")" ]]; then
            owned_process=true
        fi
    fi
    if [[ "$owned_process" != true || "$listener" != *"pid=${pid},"* ]]; then
        echo "$label port is occupied by a process outside $owner_root: ${host}:${port}" >&2
        exit 8
    fi
}

assert_port_private "Redis" "$AUTORESEARCH_REDIS_HOST" "$AUTORESEARCH_REDIS_PORT" \
    "$AUTORESEARCH_REDIS_DIR/redis.pid" "$AUTORESEARCH_REDIS_DIR"
assert_port_private "SOCKS proxy" "$AUTORESEARCH_PROXY_SOCKS_HOST" \
    "$AUTORESEARCH_PROXY_SOCKS_PORT" "$AUTORESEARCH_PROXY_HOME/xray.pid" \
    "$AUTORESEARCH_PROXY_HOME"
assert_port_private "HTTP proxy" "$AUTORESEARCH_PROXY_HTTP_HOST" \
    "$AUTORESEARCH_PROXY_HTTP_PORT" "$AUTORESEARCH_PROXY_HOME/gost.pid" \
    "$AUTORESEARCH_PROXY_HOME"

if ! "$AUTORESEARCH_PYTHON" - "$AUTORESEARCH_PROXY_HOME/vless-mlpc.json" \
    "$AUTORESEARCH_PROXY_SOCKS_HOST" "$AUTORESEARCH_PROXY_SOCKS_PORT" <<'PY'
import json
import sys

config_path, expected_host, expected_port = sys.argv[1], sys.argv[2], int(sys.argv[3])
with open(config_path, encoding="utf-8") as handle:
    config = json.load(handle)
matches = [
    inbound
    for inbound in config.get("inbounds", [])
    if inbound.get("port") == expected_port
    and inbound.get("listen") in {expected_host, "localhost"}
]
raise SystemExit(0 if matches else 1)
PY
then
    echo "Xray config must listen only on ${AUTORESEARCH_PROXY_SOCKS_HOST}:${AUTORESEARCH_PROXY_SOCKS_PORT}" >&2
    exit 8
fi

if [[ -n "$(git -C "$repo_root" status --porcelain)" ]]; then
    echo "Refusing to use a dirty source checkout: $repo_root" >&2
    exit 4
fi
if [[ ! -x "$AUTORESEARCH_CODEX_BIN" ]]; then
    echo "Codex runtime is not executable: $AUTORESEARCH_CODEX_BIN" >&2
    exit 5
fi

if ! gpu_state="$(timeout 20 nvidia-smi \
    --query-gpu=index,memory.used,utilization.gpu \
    --format=csv,noheader,nounits -i "$gpu_index")"; then
    echo "Could not query GPU $gpu_index within 20 seconds" >&2
    exit 6
fi
IFS=',' read -r observed_index memory_used utilization <<<"$gpu_state"
observed_index="${observed_index//[[:space:]]/}"
memory_used="${memory_used//[[:space:]]/}"
utilization="${utilization//[[:space:]]/}"
if [[ "$observed_index" != "$gpu_index" ]]; then
    echo "GPU identity mismatch: requested $gpu_index, observed $observed_index" >&2
    exit 6
fi
if (( memory_used > 1024 || utilization > 5 )); then
    echo "GPU $gpu_index is busy: ${memory_used} MiB, ${utilization}% utilization" >&2
    exit 6
fi
if tmux -S "$tmux_socket" has-session -t "$session_name" 2>/dev/null; then
    echo "tmux session already exists: $session_name" >&2
    exit 7
fi

commit="$(git -C "$repo_root" rev-parse HEAD)"
echo "ready: gpu=$gpu_index commit=$commit campaign=$campaign_root"
echo "resources: memory_used=${memory_used}MiB utilization=${utilization}%"
echo "streaming: prefix_range=${streaming_prefix_base}-$((streaming_prefix_base + 99999))"
echo "data: train=$lane_mds_path screen=$lane_screen_mds_path"
if [[ "$start" != true ]]; then
    echo "validation only; add --start to launch $session_name"
    exit 0
fi

mkdir -p \
    "$campaign_root" \
    "$(dirname "$log_path")" \
    "$(dirname "$tmux_socket")" \
    "$XDG_CACHE_HOME" \
    "$XDG_CONFIG_HOME" \
    "$XDG_DATA_HOME" \
    "$TMPDIR" \
    "$AUTORESEARCH_REDIS_DIR" \
    "$lane_eval_cache_path"
launch_command="cd '$repo_root' && source '$runtime_env' && export CUDA_VISIBLE_DEVICES='$gpu_index' AUTORESEARCH_CAMPAIGN_ROOT='$campaign_root' AUTORESEARCH_STREAMING_PREFIX_BASE='$streaming_prefix_base' DCLM_MDS_PATH='$lane_mds_path' DCLM_SCREEN_MDS_PATH='$lane_screen_mds_path' DCLM_EVAL_CACHE_PATH='$lane_eval_cache_path' && '$repo_root/tools/redis-start' && exec '$AUTORESEARCH_PYTHON' -u tools/run-idea-campaign-supervised.py --campaign-root '$campaign_root' --target-rounds '$target_rounds' --model '$CODEX_MODEL' --evolution-generations '$evolution_generations' >>'$log_path' 2>&1"
tmux -S "$tmux_socket" new-session -d -s "$session_name" "$launch_command"
echo "started: tmux=$session_name log=$log_path"
