#!/usr/bin/env bash
# Run the outer research-idea loop with reproducible DCLM defaults.

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
data_root="${AUTORESEARCH_DATA_ROOT:-$(dirname "$repo_root")/data}"
python_bin="${AUTORESEARCH_PYTHON:-python}"
campaign_name="${AUTORESEARCH_CAMPAIGN_NAME:-idea-campaign-$(date +%Y%m%d-%H%M%S)}"
campaign_root="${AUTORESEARCH_CAMPAIGN_ROOT:-${repo_root}/runs/${campaign_name}}"

export AUTORESEARCH_PYTHON="$python_bin"
export DCLM_MODEL_PATH="${DCLM_MODEL_PATH:-${data_root}/model-template-gpt-neox-140m}"
export DCLM_MDS_PATH="${DCLM_MDS_PATH:-${data_root}/dclm-mds-3b-v1}"
export DCLM_CORE_PATH="${DCLM_CORE_PATH:-${data_root}/dclm-core}"
export DCLM_EVAL_CACHE_PATH="${DCLM_EVAL_CACHE_PATH:-${data_root}/eval-cache}"
export AUTORESEARCH_EXPERIMENT_TIMEOUT_SECONDS="${AUTORESEARCH_EXPERIMENT_TIMEOUT_SECONDS:-43200}"
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

mkdir -p "$campaign_root"
"$repo_root/tools/redis-start"

echo "Idea campaign: $campaign_root"
echo "Visible GPUs: $CUDA_VISIBLE_DEVICES"

cd "$repo_root"
exec "$python_bin" -m autoresearch.ideas.campaign \
    --campaign-root "$campaign_root" \
    "$@"
